rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function activeStaff() {
      return staffExists() && staffData().active == true;
    }
    function role() { return staffData().role; }
    function adminRole() {
      return activeStaff() && role() in ['parish_priest', 'assistant_priest', 'secretary'];
    }
    function financeRole() { return activeStaff() && role() == 'finance_officer'; }

    match /staff/{uid} {
      // Staff can read their own profile to establish their role after sign-in.
      allow read: if signedIn() && request.auth.uid == uid || adminRole();
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /members/{id} {
      allow read: if activeStaff() && role() != 'finance_officer';
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /families/{id} {
      allow read: if activeStaff() && role() != 'finance_officer';
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /sacraments/{id} {
      allow read: if activeStaff() && role() != 'finance_officer';
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /communities/{id} {
      allow read: if activeStaff() && role() != 'finance_officer';
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /transfers/{id} {
      allow read: if activeStaff() && role() != 'finance_officer';
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /contributionCategories/{id} {
      allow read: if activeStaff();
      allow create, update: if adminRole();
      allow delete: if false;
    }
    match /contributions/{id} {
      allow read: if activeStaff();
      allow create, update: if adminRole() || financeRole();
      allow delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if adminRole();
      allow create: if activeStaff() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}